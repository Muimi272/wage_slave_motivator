{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "牛马鼓励器",
  "version": "1.0.2",
  "identifier": "com.wageslave.motivator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "牛马鼓励器",
        "width": 1180,
        "height": 800,
        "minWidth": 860,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#f5f5ef"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "实时工资与专注计时",
    "category": "Productivity",
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installMode": "currentUser"
      }
    }
  }
}
